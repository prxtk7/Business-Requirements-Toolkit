{
  // Linting uses oxlint rather than ESLint: typescript-eslint needs TypeScript's
  // JavaScript API, which the TypeScript 7 native compiler used here does not ship.
  // Rule names match their ESLint plugin equivalents.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "unicorn", "oxc", "vitest"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    // Code that is outright wrong or useless. Oxlint's default category.
    "correctness": "error"
  },
  "rules": {
    // React Hooks (eslint-plugin-react-hooks) and React Refresh (eslint-plugin-react-refresh).
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["error", { "allowConstantExport": true }],

    // Documented exceptions:
    // - The project uses React's automatic JSX runtime, so React need not be in scope.
    "react/react-in-jsx-scope": "off",
    // - Acceptance criteria store Gherkin steps as { given, when, then } (schema v5).
    //   `then` is always a string, never a function, so these objects are not thenables.
    "unicorn/no-thenable": "off",
    // - Not part of eslint-plugin-jsx-a11y's recommended or strict sets. The roles used
    //   (status live regions, a named scroll region, a modal dialog and a progress bar
    //   with custom styling) are valid WAI-ARIA patterns; swapping in <output>, <section>,
    //   <dialog> or <progress> would change behaviour, not just markup.
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": ["dist/**", "node_modules/**"]
}
